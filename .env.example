# Copy to server/.env before starting the API.
# These values are for local development only.

NODE_ENV=development
PORT=5000

# "memory" starts an ephemeral MongoDB for demos. Data is wiped when the API stops.
# For persistent data use mongodb://127.0.0.1:27017/finora (see docker-compose.yml).
MONGODB_URI=memory

CLIENT_ORIGIN=http://localhost:5173

# Replace before any shared or production deployment. Minimum 32 characters.
# The API refuses to boot in production if this still contains "dev-only".
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Ignored when NODE_ENV=production.
SEED_DEMO_DATA=true

# Server-only market data settings. Do not copy these into the client and do not use a VITE_ prefix.
# none leaves the API unconfigured. mock is development and test only.
# truedata is not installed in this build. The API does not open a market socket.
# infoway selects the Infoway adapter only when INFOWAY_API_KEY is set. A missing key stays unconfigured.
MARKET_DATA_PROVIDER=none

# Vendor environment, separate from NODE_ENV. sandbox or production.
MARKET_DATA_ENV=sandbox

# Server-only secrets. Leave empty until a TrueData contract exists.
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=

# Server-only Infoway plan key. Leave empty. Never copy this into the client, a VITE_ variable, logs, tests, or docs.
INFOWAY_API_KEY=

# Optional server-only URL overrides. Leave empty.
TRUEDATA_REALTIME_URL=
TRUEDATA_HISTORY_URL=

# Server-only. Leave empty to use a labeled in-memory quote cache.
# The API still boots when this is empty or Redis is down.
# Optional Docker Redis: redis://127.0.0.1:6379
REDIS_URL=
